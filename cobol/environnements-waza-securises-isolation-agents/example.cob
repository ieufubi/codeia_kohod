IDENTIFICATION DIVISION.
PROGRAM-ID. WAZA-SECURE-PROG.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT DATA-FILE ASSIGN TO "secure_data.dat".
    SELECT AUDIT-LOG ASSIGN TO "audit.log".
DATA DIVISION.
FILE SECTION.
FD  DATA-FILE.
01  DATA-REC        PIC X(80).
FD  AUDIT-LOG.
01  AUDIT-REC       PIC X(100).
WORKING-STORAGE SECTION.
01  WS-TOKEN        PIC X(32).
01  WS-AGENT-ID      PIC X(10).
01  WS-AUTH-STATUS   PIC X(1).
PROCEDURE DIVISION.
    DISPLAY "--- WAZA SECURITY CHECK ---" 
    ACCEPT WS-TOKEN FROM ENVIRONMENT.
    ACCEPT WS-AGENT-ID FROM ENVIRONMENT.
    
    IF WS-TOKEN = "" OR WS-TOKEN = "INVALID" THEN
        DISPLAY "CRITICAL ERROR: NO VALID WAZA TOKEN!" 
        STOP RUN
    END-IF.

    IF WS-AGENT-ID = "MALICIOUS" THEN
        DISPLAY "SECURITY VIOLATION: AGENT BLOCKED!" 
        STOP RUN
    END-IF.

    OPEN INPUT DATA-FILE
    OPEN OUTPUT AUDIT-LOG
    
    READ DATA-FILE
    WRITE AUDIT-REC FROM "ACCESS GRANTED FOR: " WS-AGENT-ID
    
    DISPLAY "DATA READ: " DATA-REC
    
    CLOSE DATA-FILE
    CLOSE AUDIT-LOG
    
    DISPLAY "--- SESSION CLOSED ---"
    STOP RUN.