IDENTIFICATION DIVISION.
PROGRAM-ID. DEPENDABOT-SIMULATOR.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CACHE-FILE ASSIGN TO "cache.dat"
    ORGANIZATION IS INDEXED
    ACCESS MODE IS RANDOM
    RECORD KEY IS CACHE-KEY.
DATA DIVISION.
FILE SECTION.
FD CACHE-FILE.
01 CACHE-RECORD.
   05 CACHE-KEY PIC X(80).
   05 CACHE-STATUS PIC X(10).
WORKING-STORAGE SECTION.
01 WS-URL PIC X(80).
01 WS-RESPONSE PIC X(20).
01 WS-EOF PIC X(1) VALUE 'N'.
PROCEDURE DIVISION.
    DISPLAY "--- DEPENDABOT PROXY SIMULATOR ---"
    DISPLAY "ENTREZ L'URL DE LA DEPENDANCE:"
    ACCEPT WS-URL FROM CONSOLE.
    
    OPEN I-O CACHE-FILE.
    
    MOVE WS-URL TO CACHE-KEY.
    READ CACHE-FILE
        INVALID KEY
            DISPLAY "RESULTAT: MISS (TELECHARGEMENT EN COURS)"
            MOVE WS-URL TO CACHE-KEY
            MOVE "EXISTS" TO CACHE-STATUS
            WRITE CACHE-RECORD
        AT END
            DISPLAY "ERREUR: FICHIER CACHE VIDE"
    END-READ.
    
    DISPLAY "RESULTAT: HIT (LIVRAISON LOCALE)"
    CLOSE CACHE-FILE.
    STOP RUN.