program StreamingBenchmarkDemo;

uses
  System.SysUtils, System.Classes;

{ Test de performance de copie de buffer }<br><br>procedure BenchmarkCopy(Size: Integer);<br>var<br>  Source, Dest: TBytesStream;<br>  Data: TBytes;<br>  I: Integer;<br>  StartTick, EndTick: Cardinal;<br>begin<br>  Data := MakeBytes(Size); // Fonction fictive pour l'exemple<br>  Source := TBytesStream.Create;<br>  Dest := TBytesStream.Create;<br>  try<br>    Source.WriteBuffer(Data[0], Size);<br>    <br>    StartTick := GetTickCount;<br>    <br>    // Simulation de lecture/écriture de flux<br>    Dest.WriteBuffer(Source.Buffer, Size);<br>    <br>    EndTick := GetTickCount;<br>    <br>    WriteLn(Format('Taille: %d octets', [Size]));<br>    WriteLn(Format('Temps: %d ms', [EndTick - StartTick]));<br>  finally<br>    Source.Free;<br>    Dest.Free;<br>  end;<br>end;<br><br>function MakeBytes(Size: Integer): TBytes;<br>var<br>  i: Integer;<br>begin<br>  Result := MakeByteT(Size);<br>  for i := 0 to Size - 1 do<br>    Result[i] := byte(i mod 256);<br>end;<br><br>function MakeByteT(Size: Integer): TBytes;<br>var<br>  B: TBytes;<br>begin<br>  SetLength(B, Size);<br>  Result := B;<br>end;<br><br>begin<br>  try<br>    WriteLn('--- Benchmark Renovate Streaming Service ---');<br>    BenchmarkCopy(1024 * 1024 * 10); // 10 MB<br>    BenchmarkCopy(1024 * 1024 * 100); // 100 MB<br>  except<br>    on E: Exception do<br>      WriteLn(E.ClassName, ': ', E.Message);<br>  end;<br>end.